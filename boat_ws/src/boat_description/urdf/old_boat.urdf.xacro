<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="boat">

  <!-- Basic material colors for RViz visualization. -->
  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.01 0.01 0.01 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 1.0 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>
  <material name="sensor_green">
    <color rgba="0.0 0.6 0.2 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.05 0 -0.15" rpy="0 0 0"/>
      <mass value="30.0"/>
      <inertia ixx="2.42369" ixy="0.0" ixz="0.0"
               iyy="3.9235025" iyz="0.0"
               izz="5.6403125"/>
    </inertial>

    <visual name="port_hull_visual">
      <origin xyz="0 0.315 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 0.18 0.18"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual name="stbd_hull_visual">
      <origin xyz="0 -0.315 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 0.18 0.18"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <visual name="deck_visual">
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.95 0.62 0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="fore_crosstube_visual">
      <origin xyz="0.36 0 0.00" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.72"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="aft_crosstube_visual">
      <origin xyz="-0.36 0 0.00" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.72"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="antenna_visual">
      <origin xyz="-0.25 0 0.42" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.50"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="flag_visual">
      <origin xyz="-0.25 0.08 0.62" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.01 0.09"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Conservative primitive collisions for early RViz/simulation checks. -->
    <collision name="port_hull_collision">
      <origin xyz="0 0.315 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 0.18 0.18"/>
      </geometry>
    </collision>
    <collision name="stbd_hull_collision">
      <origin xyz="0 -0.315 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 0.18 0.18"/>
      </geometry>
    </collision>
    <collision name="deck_collision">
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.95 0.62 0.06"/>
      </geometry>
    </collision>
  </link>

  <!--
    Port propeller link.
    Original SDF link pose: -0.488 0.295 -0.272 -90 0 90 degrees.
    Original SDF joint: motor_port_joint, revolute, axis 0 0 -1, damping 0.02.
  -->
  <link name="motor_port_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
    <visual name="port_prop_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.056" length="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision name="port_prop_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.056" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="motor_port_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_port_link"/>
    <origin xyz="-0.488 0.295 -0.272" rpy="-1.57079632679 0 1.57079632679"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!--
    Starboard propeller link.
    Original SDF link pose: -0.488 -0.295 -0.272 -90 0 90 degrees.
    Original SDF joint: motor_stbd_joint, revolute, axis 0 0 -1, damping 0.02.
  -->
  <link name="motor_stbd_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
    <visual name="stbd_prop_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.056" length="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision name="stbd_prop_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.056" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="motor_stbd_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_stbd_link"/>
    <origin xyz="-0.488 -0.295 -0.272" rpy="-1.57079632679 0 1.57079632679"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!--
    IMU frame.
    The SDF had imu_link attached to base_link with a zero-range revolute joint,
    which is equivalent to fixed for the URDF description. The SDF IMU sensor itself
    had pose 0 0 0 180 0 0 degrees. That sensor rotation is preserved here by
    rotating imu_link pi radians about X.

    If MAVROS or a driver already republishes IMU data in ROS ENU / base_link-aligned
    convention, change this joint rpy to 0 0 0 before feeding it to robot_localization.
  -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
    <visual name="imu_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.04 0.015"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="3.14159265359 0 0"/>
  </joint>

  <!--
    GPS / NavSat frame.
    Original SDF used navsat_link with pose 0 0 0.05 relative to the model and
    parented it to imu_link. For the ROS description package, gps_link is parented
    directly to base_link to avoid inheriting the IMU sensor-frame rotation.
  -->
  <link name="gps_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
    <visual name="gps_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.018"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Convenience placeholder frames for RobotX payload development. Adjust positions
       when the actual sensor mounts are finalized. -->
  <link name="compass_link"/>
  <joint name="compass_joint" type="fixed">
    <parent link="base_link"/>
    <child link="compass_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.40 0 0.35" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.325 0 0.084" rpy="0 0 0"/>
  </joint>

  <link name="sonar_link"/>
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0.15 0 -0.20" rpy="0 0 0"/>
  </joint>

  <!--
    SDF plugin details intentionally not represented in URDF:
      - JointStatePublisher system
      - OdometryPublisher system: odom -> base_link runtime TF
      - Thruster plugins:
          motor_port_joint, thrust_coefficient -0.02, diameter 0.112 m
          motor_stbd_joint, thrust_coefficient  0.02, diameter 0.112 m
      - Hydrodynamics plugin on blueboat::base_link
      - ArduPilotPlugin:
          fdm_addr 127.0.0.1, fdm_port_in 9002
          imuName imu_link::imu_sensor
          channel 0 -> motor_port_joint -> /model/blueboat/joint/motor_port_joint/cmd_thrust
          channel 2 -> motor_stbd_joint -> /model/blueboat/joint/motor_stbd_joint/cmd_thrust
  -->

</robot>