<?xml version="1.0"?>
<package format="3">
  <name>robotx_coordination</name><version>0.1.0</version>
  <description>RobotX georeferenced mapping and coordinated navigation</description>
  <maintainer email="robotx@localhost">RobotX Team</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>robotx_coordination_interfaces</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
