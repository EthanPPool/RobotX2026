<?xml version="1.0"?>
<package format="3">
  <name>robotx_coordination_interfaces</name><version>0.1.0</version>
  <description>Georeferenced imagery and semantic buoy maps</description>
  <maintainer email="robotx@localhost">RobotX Team</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
