<?xml version="1.0"?>
<package format="3">
  <name>uav_bringup</name>
  <version>0.3.0</version>
  <description>Launch and configuration package for the RobotX UAV autonomy stack.</description>
  <maintainer email="robotxuav@example.com">RobotX UAV Team</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>uav_vehicle</exec_depend>
  <exec_depend>uav_safety</exec_depend>
  <exec_depend>uav_control</exec_depend>
  <exec_depend>uav_perception</exec_depend>
  <exec_depend>uav_mission</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
