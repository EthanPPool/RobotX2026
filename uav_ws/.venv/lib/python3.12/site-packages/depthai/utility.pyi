import depthai
import numpy
from typing import overload

@overload
def colorizeDepthFrame(frame: depthai.ImgFrame, minDepth: float = ..., maxDepth: float = ..., colormap: int = ..., useLog: bool = ...) -> depthai.ImgFrame:
    """colorizeDepthFrame(*args, **kwargs)
    Overloaded function.

    1. colorizeDepthFrame(frame: depthai.ImgFrame, minDepth: float = 300.0, maxDepth: float = 12000.0, colormap: int = 2, useLog: bool = True) -> depthai.ImgFrame

    Colorize a single-channel depth frame into a BGR888i ImgFrame.

    If ``maxDepth`` is less than or equal to ``minDepth`` (e.g. both set to 0), the
    effective bounds are auto-computed from the 3rd and 95th percentiles of the
    finite positive (valid) depth values.

    Parameter ``frame``:
        Input depth frame (single channel, e.g. RAW16/GRAYF16/GRAY8). Depth values
        are usually in millimeters.

    Parameter ``minDepth``:
        Lower depth bound in millimeters of the range to map to 0 (default: 300 mm).

    Parameter ``maxDepth``:
        Upper depth bound in millimeters of the range to map to 255 (default: 12000
        mm).

    Parameter ``colormap``:
        OpenCV colormap to apply (default: COLORMAP_JET).

    Parameter ``useLog``:
        If true, apply logarithmic scaling before mapping to [0, 255].

    Returns:
        New BGR888i ImgFrame containing the colorized depth image. Invalid (non-
        positive or non-finite) pixels are set to black.

    2. colorizeDepthFrame(frame: numpy.ndarray, minDepth: float = 300.0, maxDepth: float = 12000.0, colormap: int = 2, useLog: bool = True) -> numpy.ndarray

    Colorize a single-channel depth cv::Mat.

    If ``maxDepth`` is less than or equal to ``minDepth`` (e.g. both set to 0), the
    effective bounds are auto-computed from the 3rd and 95th percentiles of the
    finite positive (valid) depth values.

    Parameter ``frame``:
        Input depth frame (single channel, e.g. CV_16U/CV_32F/CV_8U). Depth values
        are usually in millimeters.

    Parameter ``minDepth``:
        Lower depth bound in millimeters of the range to map to 0 (default: 300 mm).

    Parameter ``maxDepth``:
        Upper depth bound in millimeters of the range to map to 255 (default: 12000
        mm).

    Parameter ``colormap``:
        OpenCV colormap to apply (default: COLORMAP_JET).

    Parameter ``useLog``:
        If true, apply logarithmic scaling before mapping to [0, 255].

    Returns:
        BGR cv::Mat colorized depth image. Invalid (non-positive or non-finite)
        pixels are set to black.
    """
@overload
def colorizeDepthFrame(frame: numpy.ndarray, minDepth: float = ..., maxDepth: float = ..., colormap: int = ..., useLog: bool = ...) -> numpy.ndarray:
    """colorizeDepthFrame(*args, **kwargs)
    Overloaded function.

    1. colorizeDepthFrame(frame: depthai.ImgFrame, minDepth: float = 300.0, maxDepth: float = 12000.0, colormap: int = 2, useLog: bool = True) -> depthai.ImgFrame

    Colorize a single-channel depth frame into a BGR888i ImgFrame.

    If ``maxDepth`` is less than or equal to ``minDepth`` (e.g. both set to 0), the
    effective bounds are auto-computed from the 3rd and 95th percentiles of the
    finite positive (valid) depth values.

    Parameter ``frame``:
        Input depth frame (single channel, e.g. RAW16/GRAYF16/GRAY8). Depth values
        are usually in millimeters.

    Parameter ``minDepth``:
        Lower depth bound in millimeters of the range to map to 0 (default: 300 mm).

    Parameter ``maxDepth``:
        Upper depth bound in millimeters of the range to map to 255 (default: 12000
        mm).

    Parameter ``colormap``:
        OpenCV colormap to apply (default: COLORMAP_JET).

    Parameter ``useLog``:
        If true, apply logarithmic scaling before mapping to [0, 255].

    Returns:
        New BGR888i ImgFrame containing the colorized depth image. Invalid (non-
        positive or non-finite) pixels are set to black.

    2. colorizeDepthFrame(frame: numpy.ndarray, minDepth: float = 300.0, maxDepth: float = 12000.0, colormap: int = 2, useLog: bool = True) -> numpy.ndarray

    Colorize a single-channel depth cv::Mat.

    If ``maxDepth`` is less than or equal to ``minDepth`` (e.g. both set to 0), the
    effective bounds are auto-computed from the 3rd and 95th percentiles of the
    finite positive (valid) depth values.

    Parameter ``frame``:
        Input depth frame (single channel, e.g. CV_16U/CV_32F/CV_8U). Depth values
        are usually in millimeters.

    Parameter ``minDepth``:
        Lower depth bound in millimeters of the range to map to 0 (default: 300 mm).

    Parameter ``maxDepth``:
        Upper depth bound in millimeters of the range to map to 255 (default: 12000
        mm).

    Parameter ``colormap``:
        OpenCV colormap to apply (default: COLORMAP_JET).

    Parameter ``useLog``:
        If true, apply logarithmic scaling before mapping to [0, 255].

    Returns:
        BGR cv::Mat colorized depth image. Invalid (non-positive or non-finite)
        pixels are set to black.
    """
