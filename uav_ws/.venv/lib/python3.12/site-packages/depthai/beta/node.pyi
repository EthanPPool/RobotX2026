    def setMaskOutputs(self, maskOutputs: list[str]) -> None:
        '''setMaskOutputs(self: depthai.beta.node.FastSAMParser, maskOutputs: list[str]) -> None

        Sets the names of the model\'s mask-coefficient output layers. Only names
