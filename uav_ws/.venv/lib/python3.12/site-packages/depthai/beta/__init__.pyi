class Keypoints(depthai.Buffer, depthai.Transformable):
    """Keypoints message. Streamable wrapper around the native dai::KeypointsList,
    carrying 2D or 3D keypoints together with optional skeleton edges connecting
    them.

    Keypoint image coordinates are normalized to [0, 1] by the keypoint parsers. 2D
    keypoints carry a z coordinate of 0."""
    keypointsList: depthai.KeypointsList
    def __init__(self) -> None:
        """__init__(self: depthai.beta.Keypoints) -> None"""
    def getEdges(self, *args, **kwargs):
        """getEdges(self: depthai.beta.Keypoints) -> list[Annotated[list[int], FixedSize(2)]]

        Returns the skeleton edges as pairs of keypoint indices.
        """
    def getKeypoints(self) -> list[depthai.Keypoint]:
        """getKeypoints(self: depthai.beta.Keypoints) -> list[depthai.Keypoint]

        Returns the keypoints.
        """
    def getPoints2f(self) -> depthai.VectorPoint2f:
        """getPoints2f(self: depthai.beta.Keypoints) -> depthai.VectorPoint2f

        Returns the 2D image coordinates of the keypoints, dropping the z axis values.
        """
    def getPoints3f(self) -> list[depthai.Point3f]:
        """getPoints3f(self: depthai.beta.Keypoints) -> list[depthai.Point3f]

        Returns the 3D image coordinates of the keypoints. 2D keypoints carry a z
        coordinate of 0.
        """
    def getVisualizationMessage(self) -> depthai.ImgAnnotations | depthai.ImgFrame | None:
        """getVisualizationMessage(self: depthai.beta.Keypoints) -> Union[depthai.ImgAnnotations, depthai.ImgFrame, None]

        Returns an ImgAnnotations visualization with the keypoints drawn as points and
        the skeleton edges drawn as lines.
        """
    def setEdges(self, edges) -> None:
        """setEdges(self: depthai.beta.Keypoints, edges: list[Annotated[list[int], FixedSize(2)]]) -> None

        Sets the skeleton edges.

        Parameter ``edges``:
            Pairs of keypoint indices to connect.

        Throws:
            std::invalid_argument if an edge index is out of range or an edge is a self-
            loop.
        """
    @overload
    def setKeypoints(self, keypoints: list[depthai.Keypoint]) -> None:
        """setKeypoints(*args, **kwargs)
        Overloaded function.

        1. setKeypoints(self: depthai.beta.Keypoints, keypoints: list[depthai.Keypoint]) -> None

        Sets the keypoints.

        Parameter ``keypoints``:
            Keypoints to set. @note This clears any existing keypoints and edges.

        2. setKeypoints(self: depthai.beta.Keypoints, keypoints: list[depthai.Keypoint], edges: list[Annotated[list[int], FixedSize(2)]]) -> None

        Sets the keypoints together with the skeleton edges connecting them.

        Parameter ``keypoints``:
            Keypoints to set.

        Parameter ``edges``:
            Pairs of keypoint indices to connect. Example: {{0, 1}, {1, 2}} connects
            keypoint 0 to keypoint 1 and keypoint 1 to keypoint 2.

        Throws:
            std::invalid_argument if an edge index is out of range or an edge is a self-
            loop.
        """
    @overload
    def setKeypoints(self, keypoints: list[depthai.Keypoint], edges) -> None:
        """setKeypoints(*args, **kwargs)
        Overloaded function.

        1. setKeypoints(self: depthai.beta.Keypoints, keypoints: list[depthai.Keypoint]) -> None

        Sets the keypoints.

        Parameter ``keypoints``:
            Keypoints to set. @note This clears any existing keypoints and edges.

        2. setKeypoints(self: depthai.beta.Keypoints, keypoints: list[depthai.Keypoint], edges: list[Annotated[list[int], FixedSize(2)]]) -> None

        Sets the keypoints together with the skeleton edges connecting them.

        Parameter ``keypoints``:
            Keypoints to set.

        Parameter ``edges``:
            Pairs of keypoint indices to connect. Example: {{0, 1}, {1, 2}} connects
            keypoint 0 to keypoint 1 and keypoint 1 to keypoint 2.

        Throws:
            std::invalid_argument if an edge index is out of range or an edge is a self-
            loop.
        """
    def transformTo(self, target: depthai.ImgTransformation) -> Keypoints:
        """transformTo(self: depthai.beta.Keypoints, target: depthai.ImgTransformation) -> depthai.beta.Keypoints

        Returns a new Keypoints message with the keypoint image coordinates remapped
        from this message's transformation into the target transformation.

        Parameter ``target``:
            Target image transformation.

        Throws:
            std::runtime_error if this message carries no transformation metadata.
        """

