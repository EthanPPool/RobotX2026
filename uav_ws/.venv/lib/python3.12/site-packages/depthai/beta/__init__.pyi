class Predictions(depthai.Buffer, depthai.Transformable):
    """Predictions message. Carries the predicted value(s) of a regression model in the
    order the model emitted them.

    The message may carry no predictions when the parsed tensor is empty."""
    predictions: list[Prediction]
    def __init__(self) -> None:
        """__init__(self: depthai.beta.Predictions) -> None"""
    def getFirstPrediction(self) -> float:
        """getFirstPrediction(self: depthai.beta.Predictions) -> float

        Returns the first predicted value. Useful for single-prediction models.

        Throws:
            std::runtime_error if the message contains no predictions.
        """
    def getVisualizationMessage(self) -> depthai.ImgAnnotations | depthai.ImgFrame | None:
        """getVisualizationMessage(self: depthai.beta.Predictions) -> Union[depthai.ImgAnnotations, depthai.ImgFrame, None]

        Returns an ImgAnnotations visualization with each predicted value drawn as text,
        one below the other, or std::monostate when no transformation metadata is
        available to derive the annotation layout from.
        """
    def transformTo(self, target: depthai.ImgTransformation) -> Predictions:
        """transformTo(self: depthai.beta.Predictions, target: depthai.ImgTransformation) -> depthai.beta.Predictions

        Returns a new Predictions message with the transformation metadata replaced by
        the target transformation. Regression results carry no spatial data, so the
        predictions are unchanged.

        Parameter ``target``:
            Target image transformation.
        """

