class Classifications(depthai.Buffer, depthai.Transformable):
    """Classifications message. Carries classification class names and their
    corresponding scores.

    The classes and scores vectors are index-aligned. Parsers emit them sorted in
    descending order of score, so the first entry is the most probable class."""
    classes: list[str]
    scores: numpy.ndarray[numpy.float32]
    def __init__(self) -> None:
        """__init__(self: depthai.beta.Classifications) -> None"""
    def getTopClass(self) -> str:
        """getTopClass(self: depthai.beta.Classifications) -> str

        Returns the most probable class name.

        Assumes the classes are sorted in descending order of score, which holds for
        parser-emitted messages.

        Throws:
            std::runtime_error if the message contains no classes.
        """
    def getTopScore(self) -> float:
        """getTopScore(self: depthai.beta.Classifications) -> float

        Returns the score of the most probable class.

        Assumes the scores are sorted in descending order, which holds for parser-
        emitted messages.

        Throws:
            std::runtime_error if the message contains no scores.
        """
    def getVisualizationMessage(self) -> depthai.ImgAnnotations | depthai.ImgFrame | None:
        """getVisualizationMessage(self: depthai.beta.Classifications) -> Union[depthai.ImgAnnotations, depthai.ImgFrame, None]

        Returns an ImgAnnotations visualization with up to the top five classes and
        their scores, or std::monostate when no transformation metadata is available to
        derive the annotation layout from.
        """
    def transformTo(self, target: depthai.ImgTransformation) -> Classifications:
        """transformTo(self: depthai.beta.Classifications, target: depthai.ImgTransformation) -> depthai.beta.Classifications

        Returns a new Classifications message with the transformation metadata replaced
        by the target transformation. Classification results carry no spatial data, so
        classes and scores are unchanged.

        Parameter ``target``:
            Target image transformation.
        """

