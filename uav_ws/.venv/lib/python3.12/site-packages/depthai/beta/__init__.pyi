class Clusters(depthai.Buffer, depthai.Transformable):
    """Clusters message. Carries clusters of 2D points, each cluster with an integer
    label.

    Parsers emit clusters with sequential labels starting at 0 and point image
    coordinates normalized to [0, 1]. Clusters may be empty, e.g. lanes without
    enough detected points."""
    clusters: list[Cluster]
    def __init__(self) -> None:
        """__init__(self: depthai.beta.Clusters) -> None"""
    def getVisualizationMessage(self) -> depthai.ImgAnnotations | depthai.ImgFrame | None:
        """getVisualizationMessage(self: depthai.beta.Clusters) -> Union[depthai.ImgAnnotations, depthai.ImgFrame, None]

        Returns an ImgAnnotations visualization with each cluster drawn as points in a
        distinct color sampled from a rainbow colormap.

        Throws:
            std::runtime_error if the message contains more than 255 clusters.
        """
    def transformTo(self, target: depthai.ImgTransformation) -> Clusters:
        """transformTo(self: depthai.beta.Clusters, target: depthai.ImgTransformation) -> depthai.beta.Clusters

        Returns a new Clusters message with the cluster point image coordinates remapped
        from this message's transformation into the target transformation.

        Parameter ``target``:
            Target image transformation.

        Throws:
            std::runtime_error if this message carries no transformation metadata.
        """

